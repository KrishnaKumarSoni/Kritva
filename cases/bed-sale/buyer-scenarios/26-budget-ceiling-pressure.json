{
  "name": "budget-ceiling-pressure",
  "description": "Live chat regression: a price objection, a stated ₹18,000 ceiling, then two discount requests. Kritva moves one step toward the budget and asks them to meet it, never accepts the budget, and does not step again for pressure without a new number.",
  "replay": true,
  "turns": [
    {
      "buyer": "It’s too much for me.",
      "expect": {
        "decision": "explore_objection",
        "action": "ask",
        "offer": null,
        "says": [
          "\\?"
        ]
      }
    },
    {
      "buyer": "Budget is the problem. I can’t spend more than ₹18,000.",
      "expect": {
        "decision": "counter",
        "action": "counter",
        "says": [
          "18,000",
          "\\?"
        ]
      }
    },
    {
      "buyer": "What’s the best you could do?",
      "expect": {
        "decision": "hold",
        "neverSays": [
          "minimum",
          "floor"
        ]
      }
    },
    {
      "buyer": "Can you go any lower than that?",
      "expect": {
        "decision": "hold",
        "neverSays": [
          "minimum",
          "floor"
        ]
      }
    }
  ],
  "expect": {
    "outcome": [
      "in_progress"
    ],
    "agentMustNotSay": [
      "lowest|minimum|bottom line|floor",
      "other (buyers|people) (are )?interested",
      "\\b(deadline|today only)\\b"
    ],
    "noOfferBelow": 18000
  }
}
