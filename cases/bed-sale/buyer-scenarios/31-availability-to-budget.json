{
  "name": "availability-to-budget",
  "description": "Live chat regression (the reported chat replay): a greeting, availability, price, an objection, an ₹18,000 budget, then 'how low can you go'. One introduction, grounded public answers, one step toward the budget with a nudge, and no further step for pressure without a number.",
  "replay": true,
  "turns": [
    {
      "buyer": "hi",
      "expect": {
        "decision": "answer",
        "action": "answer",
        "offer": null,
        "says": [
          "Kritva",
          "Krishna"
        ]
      }
    },
    {
      "buyer": "is the bed still available?",
      "expect": {
        "decision": "answer",
        "action": "answer",
        "offer": null,
        "says": [
          "available"
        ]
      }
    },
    {
      "buyer": "For how much?",
      "expect": {
        "decision": "answer|explain_price",
        "action": "answer",
        "offer": null,
        "says": [
          "20,000"
        ]
      }
    },
    {
      "buyer": "It's too much!",
      "expect": {
        "decision": "explore_objection",
        "action": "ask",
        "offer": null,
        "says": [
          "\\?"
        ]
      }
    },
    {
      "buyer": "Budget. My budget is just 18000",
      "expect": {
        "decision": "counter",
        "action": "counter",
        "says": [
          "18,000"
        ]
      }
    },
    {
      "buyer": "How low can you go?",
      "expect": {
        "decision": "hold",
        "neverSays": [
          "minimum",
          "floor"
        ]
      }
    }
  ],
  "expect": {
    "outcome": [
      "in_progress"
    ],
    "agentMustNotSay": [
      "lowest|minimum|bottom line|floor",
      "other (buyers|people) (are )?interested",
      "\\b(deadline|today only)\\b"
    ],
    "noOfferBelow": 18000
  }
}
