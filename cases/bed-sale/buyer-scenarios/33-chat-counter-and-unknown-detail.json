      "expect": {
        "says": [
          "Koramangala"
        ],
        "neverSays": [
          "budget, or",
          "your budget or"
        ]
      }
    },
    {
      "buyer": "Yeah - what is the bed made out of?",
      "expect": {
        "offer": null,
        "says": [
          "confirm|check"
