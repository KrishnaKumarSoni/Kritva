      "expect": {
        "decision": "request_approval",
        "action": "accept",
        "says": [
          "\\?"
        ],
        "neverSays": [
          "it'?s yours",
          "we'?re agreed",
          "we are agreed",
          "\\bdeal\\b"
        ]
      }
    },
    {
      "buyer": "It's good till tonight.",
      "expect": {
        "says": [
          "\\?"
        ],
        "neverSays": [
          "we'?re agreed",
          "we are agreed",
          "\\bdeal\\b",
          "it'?s yours"
        ]
      }
    },
    {
      "buyer": "Just message me here, any time is fine.",
      "expect": {
        "says": [
          "final|confirm"
        ],
        "neverSays": [
          "\\?",
          "we'?re agreed",
          "we are agreed",
          "\\bdeal\\b",
          "it'?s yours"
        ]
      }
    },
    {
