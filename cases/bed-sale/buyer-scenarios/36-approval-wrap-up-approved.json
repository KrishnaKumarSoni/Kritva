        ],
        "neverSays": [
          "we'?re agreed",
          "we are agreed"
        ]
      }
    },
    {
      "buyer": "Yes, still good!",
      "expect": {
        "decision": "record_agreement",
        "action": "accept"
      }
    }
  ],
  "expect": {
    "outcome": [
      "agreement"
    ],
    "agreedAmountAtLeast": 20000,
    "acceptancesMatchStatedTerms": true,
    "agentMustNotSay": [
