{
  "name": "kritva",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:live": "npm run test:live --workspaces --if-present",
    "scenarios": "node --env-file-if-exists=.env apps/server/scripts/run-scenarios.ts",
    "dev": "echo \"Start the server (npm run dev -w @kritva/server) and the web app (npm run dev -w @kritva/web)\"",
    "email:setup": "node --env-file-if-exists=.env apps/server/scripts/email-setup.ts"
  }
}
